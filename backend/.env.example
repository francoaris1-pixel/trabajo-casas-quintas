# Configuracion SMTP para envio de correos.
# Ejemplo con Gmail:
#   1. Activá verificacion en 2 pasos en tu cuenta de Google
#   2. Genera una "Contrasena de aplicacion": https://myaccount.google.com/apppasswords
#   3. Colocala en SMTP_PASS (no uses tu contrasena normal)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu-clave-de-aplicacion
MAIL_FROM=Casas & Quintas <tucorreo@gmail.com>
