# Base local aislada para pruebas. No apuntar a produccion.
# Copiar este archivo a .env para iniciar el backend local.
# Cuentas de prueba: admin@quintasgoya.com, anfitrion@quintasgoya.com e inquilino@quintasgoya.com.
# Sus claves son las definidas en las variables SEED_* de abajo.
MONGODB_URI=mongodb://127.0.0.1:27017/goya_quintas_test
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
SEED_DEMO_DATA=true
SEED_ADMIN_PASSWORD=admin-prueba-2026
SEED_OWNER_PASSWORD=anfitrion-prueba-2026
SEED_CUSTOMER_PASSWORD=inquilino-prueba-2026
CORS_ORIGIN=http://localhost:5173

# Configuracion SMTP para envio de correos.
# Dejar SMTP_USER y SMTP_PASS vacios para mostrar correos solo en consola.
# Ejemplo con Gmail:
#   1. Activá verificacion en 2 pasos en tu cuenta de Google
#   2. Genera una "Contraseña de aplicacion": https://myaccount.google.com/apppasswords
#   3. Colocala en SMTP_PASS (no uses tu contraseña normal)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
